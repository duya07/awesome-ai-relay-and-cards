    {
      "name": "ClaudeMax",
      "url": "https://claudemax.shop/",
      "system_type": "independent_shop",
      "notes": "主打海外成品号与月度订阅代充，支持 USDT 结算"
    }
  ],
  "common_goods_synonyms": {
    "muse": ["Muse AI", "Muse", "Meta Muse", "10亿 Token", "10亿token邀请", "Meta 智能体"],
    "claude": ["Claude Pro", "Claude 3.7", "Claude Team", "克劳德独享", "Anthropic 官号"],
    "chatgpt": ["ChatGPT Plus", "GPT-4o", "OpenAI 独享号", "ChatGPT Team"]
