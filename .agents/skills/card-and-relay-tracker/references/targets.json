{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.1.0",
  "description": "awesome-ai-relay-and-cards 聚合导航、比价靶标与规格特征字典",
  "aggregators": [
    {
      "name": "PriceAI",
      "url": "https://priceai.cc/",
      "tier": "T0",
      "type": "card_aggregator",
      "search_path": "/?q={keyword}",
      "features": ["现货库存曲线", "历史价格", "多渠道对比"]
    },
    {
      "name": "就爱比 (9AIB)",
      "url": "https://9aib.com/",
      "tier": "T0",
      "type": "card_aggregator",
      "search_path": "/search?k={keyword}",
      "features": ["350+店铺验真", "现货底价雷达", "真实性监控"]
    },
    {
      "name": "水獭比价",
      "url": "https://shuita.xyz/",
      "tier": "T1",
      "type": "card_aggregator",
      "search_path": "/?q={keyword}",
      "sku_path": "/sku/{sku_slug}",
      "features": ["有货优先排序", "周边分类", "126家发卡网现货", "SKU直链穿透"]
    },
    {
      "name": "GetCheapAI",
      "url": "https://www.getcheapai.com/zh-cn",
      "tier": "T1",
      "type": "relay_and_card_price",
      "search_path": "/zh-cn?q={keyword}",
      "features": ["520+模型价格", "90分钟可用性探针", "每百万Token折算"]
    },
    {
      "name": "MODELOC",
      "url": "https://modeloc.com/relays",
      "tier": "T1",
      "type": "relay_audit_directory",
      "api_path": "/relays/list?sort=rating&limit=24",
      "features": ["原始一致性检测", "掺水模型排查", "中转审计打分", "用户星级评价"]
    },
    {
      "name": "Veridrop (真伪榜)",
      "url": "https://veridrop.org/",
      "tier": "T1",
      "type": "relay_authenticity",
      "features": ["官转纯度检测", "自动化探针抽检", "防逆向伪装"]
    }
  ],
  "spec_filters": {
    "finished_account": {
      "desc": "开箱即用成品号（已开通/已绑卡/带账号密码）",
      "positive_keywords": ["成品", "独享", "已绑卡", "带原邮", "带邮箱", "直登", "全新号", "开箱即用", "自动发货", "独享号"],
      "negative_keywords": ["代认证", "单认证", "自备", "代充", "包过", "需自备", "提供账号", "拍下发账号", "扫码登录", "只包认证", "不含订阅", "代过SheerID", "代开", "充值自身"]
    },
    "recharge_or_verify_service": {
      "desc": "纯代充/代认证服务（买家自备账号）",
      "positive_keywords": ["代认证", "单认证", "自备账号", "代充", "代过", "充值"],
      "negative_keywords": ["成品", "开箱即用", "带原邮"]
    }
  },
  "sku_definitions": {
    "gpt_plus_student": {
      "canonical_name": "ChatGPT Plus 4个月学生号成品",
      "synonyms": ["gpt_plus_student", "ChatGPT学生号", "Plus学生成品", "GPT4个月教育优惠"],
      "expected_duration_months": 4,
      "price_benchmark_range": [120, 180]
    },
    "muse_ai_1b": {
      "canonical_name": "Muse AI 10亿Token成品号",
      "synonyms": ["muse", "muse_ai", "10亿Token", "Meta Muse", "10亿token邀请"],
      "price_benchmark_range": [15, 25]
    },
    "claude_pro_solo": {
      "canonical_name": "Claude Pro 独享月度号",
      "synonyms": ["claude pro", "claude独享", "claude 3.7", "claude成品"],
      "price_benchmark_range": [120, 160]
    }
  }
}
